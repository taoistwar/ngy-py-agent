# Copy to .env in the repository root and fill in the real values.
# .env is git-ignored: never commit it, and never paste real keys here.

# --- Ollama / OpenAI-compatible provider ---
OLLAMA_BASE_URL=http://127.0.0.1:12434/v1
OLLAMA_MODEL=qwen3:0.6b

# --- Dev-only shortcuts read by main.py ---
# Set to "dev" to make main.py take the query from NGY_PY_AGNET_QUERY.
NGY_PY_AGENT_MODE=
# Spelled AGNET on purpose: that is the name main.py reads.
NGY_PY_AGNET_QUERY=

# --- Agnes Video 2.5 (used by llm/agnes_video_test.py) ---
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_API_KEY=

# --- OpenTelemetry tracing (off by default) ---
# true/1/yes/on turns on spans for HTTP requests, tasks, ReAct steps, model calls
# and tool calls. Anything else (or leaving it empty) keeps the old behaviour.
OTEL_TRACING_ENABLED=false
# console | jsonl | none
OTEL_TRACES_EXPORTER=jsonl
# Relative paths resolve against the repository root; data/traces/ is git-ignored.
OTEL_TRACES_JSONL_PATH=data/traces/spans.jsonl
# Fraction of traces to keep, 0.0-1.0.
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SERVICE_NAME=ngy-py-agent
